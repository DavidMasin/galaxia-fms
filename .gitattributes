# Keep LF line endings in the working tree on every OS. gofmt and the CI format check require LF, and shell
# scripts and firmware sources break with CRLF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.db binary
*.zip binary
*.gz binary
